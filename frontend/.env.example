# Next.js Frontend Environment Variables
# Copy these to your .env.local for local development
# or set them in the Vercel Dashboard Settings -> Environment Variables

# Supabase Credentials (from your Supabase project dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (e.g. your Render backend URL with /api path, or http://localhost:5000/api locally)
NEXT_PUBLIC_API_URL=https://your-backend-app.onrender.com/api
