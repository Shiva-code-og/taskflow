# Backend Environment Variables
# Copy these to your .env for local development
# or set them in the Render Dashboard -> Environment -> Environment Variables

PORT=5000

# Comma-separated list of allowed frontend origins (including your Vercel domain and localhost)
FRONTEND_URL=https://your-app.vercel.app,http://localhost:3000

# Supabase Credentials (from Supabase Dashboard -> Settings -> API & JWT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Email Service: Brevo (Recommended for Render & sending to any email)
# Get your API key from: Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=samalashiva81@gmail.com
BREVO_SENDER_NAME=TaskFlow

# (Optional Fallback) Resend API Key
# Note: Resend onboarding@resend.dev only allows sending to the account owner's email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=TaskFlow <onboarding@resend.dev>

# (Optional Fallback) Gmail SMTP Credentials (Note: Render blocks SMTP ports)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
